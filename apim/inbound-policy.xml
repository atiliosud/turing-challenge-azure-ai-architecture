<policies>
  <inbound>
    <base />
    <!-- Configure Entra issuer/audience via named values before deploying. -->
    <validate-jwt header-name="Authorization" failed-validation-httpcode="401" require-scheme="Bearer">
      <openid-config url="{{entra-openid-config-url}}" />
      <audiences><audience>{{api-audience}}</audience></audiences>
      <required-claims><claim name="roles" match="any"><value>TechSolutions.Submit</value></claim></required-claims>
    </validate-jwt>
    <choose>
      <when condition="@(context.Subscription == null)">
        <return-response>
          <set-status code="401" reason="Subscription required" />
        </return-response>
      </when>
    </choose>
    <!-- subscription-id is configured per customer; use authenticated app identity for billing ledger. -->
    <rate-limit-by-key calls="30" renewal-period="60" counter-key="@(context.Subscription?.Id ?? &quot;unknown&quot;)" />
    <quota-by-key calls="100000" renewal-period="2592000" counter-key="@(context.Subscription?.Id ?? &quot;unknown&quot;)" />
    <set-header name="x-correlation-id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
